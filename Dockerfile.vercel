# Build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish WebApiApp.csproj -c Release -o /app

# Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .

# A Vercel injeta a porta em $PORT (padrão 80); o Program.cs já lê essa variável.
ENV ASPNETCORE_ENVIRONMENT=Production
CMD ["dotnet", "WebApiApp.dll"]
